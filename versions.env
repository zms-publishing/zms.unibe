AGENDA_CATEGORIES_URL=http://zms:8080/unibe/agenda-categories.json
API_RQ=true
API_V1=true
API_V3=true
BASE_IMAGE=python3.14.9-zope6.3
COMPOSE_INCLUDE=dev
DEBUG_MODE=true
FASTAPI_CACHE_ENABLED=false
FASTAPI_EXTRAS=zope,fastapi
FORWARDED_ALLOW_IPS=*
PORTAL_MASTER=/unibe/content
PYTHON_VERSION=3.14.9
PYTHONUNBUFFERED=true
QUEUE_NAME=default
REDIS_URL=redis://127.0.0.1:6379
RUN_MIGRATIONS=false
SETUPTOOLS_VERSION=80.10.2
SQLDB_STORAGE=postgresql://postgres:thisIsMyRoot@127.0.0.1:5432/cms_formulator
UVICORN_PORT=5555
ZEO_URL=host.docker.internal:8000
ZMS_CORE_BRANCH_OR_COMMIT=main
ZMS_ENABLE_CSP_HEADERS=true
ZMS_ENABLE_MARKDOWN_RENDERING=true
ZMS_EXTRAS=zope,msgraphapi
ZMS_UNIBE_BRANCH_OR_COMMIT=main
ZMS_URL=http://127.0.0.1:8080
ZMS_UV_PACKAGE_MANAGER=true
ZODB_CONF=zodb-relstorage.conf
ZODB_RELSTORAGE_DB_HOST=127.0.0.1
ZODB_RELSTORAGE_DB_NAME=zodb
ZODB_RELSTORAGE_DB_PASSWORD=thisIsMyRoot
ZODB_RELSTORAGE_DB_USER=postgres
ZODB_STORAGE=zeo://zeo:8000?storage=main
ZOPE_VERSION=master