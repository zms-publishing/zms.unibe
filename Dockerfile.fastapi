ARG PYTHON_VERSION

FROM python:$PYTHON_VERSION
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app/dev
COPY dev/pyproject.toml dev/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

WORKDIR /app
COPY . .

WORKDIR /app/dev
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen

ENV PATH="/app/dev/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

COPY ./src/zms/unibe/conf/* /app/dev/etc/

CMD ["/app/dev/.venv/bin/fastapi", "dev", "--entrypoint", "zms.unibe.fastapi.app:api", "--host", "0.0.0.0", "--port", "8000"]